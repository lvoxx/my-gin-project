# =============================================================================
# Employee Management System — Development Environment
# All REPLACE-ME values must be substituted before deployment.
# This file is loaded automatically when APP_ENV != production.
# =============================================================================

# Application
APP_ENV=development
APP_PORT=8080
APP_MAX_FILE_SIZE_MB=5

# Gin mode: debug | release | test
GIN_MODE=debug

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=REPLACE-ME
POSTGRES_PASSWORD=REPLACE-ME
POSTGRES_DB=employee_mgmt
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5
POSTGRES_MAX_CONN_LIFETIME_MINUTES=30

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=REPLACE-ME
REDIS_DB=0
REDIS_CACHE_TTL_MINUTES=15

# JWT  (use a random 32+ char secret in production)
JWT_SECRET=REPLACE-ME
JWT_ACCESS_TOKEN_EXP_MINUTES=60
JWT_REFRESH_TOKEN_EXP_DAYS=7

# Cloudinary (leave blank to use local fallback in development)
CLOUDINARY_CLOUD_NAME=REPLACE-ME
CLOUDINARY_API_KEY=REPLACE-ME
CLOUDINARY_API_SECRET=REPLACE-ME
CLOUDINARY_FOLDER=simple-employees-crud/avatars

# Logging
LOG_DIR=./logs
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=7
LOG_MAX_AGE_DAYS=30
